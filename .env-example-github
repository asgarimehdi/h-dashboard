PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.cxgyiljxwglbnceransg
DB_PASSWORD=${{ secrets.DB_PASSWORD }}
DB_ROOT_PASSWORD=<same-as-dev>
DB_DEFAULT_EMAIL=admin@...
DB_DEFAULT_PASSWORD=<same-as-dev>

# Application timezone (display layer). PostgreSQL keeps UTC for storage;
# convert to Tehran/Jalali in code via morilog/jalali & hekmatinasser/verta.
APP_TIMEZONE=Asia/Tehran

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Session Secure flag DERIVES from the request scheme when unset (startup-safe
# on every server): https requests — direct nginx/fastcgi HTTPS, or
# X-Forwarded-Proto:https from a proxy pinned in TRUSTED_PROXIES — mark the
# cookie Secure automatically; plaintext dev servers (`php artisan serve`,
# e2e on :8001) keep a usable non-Secure cookie so login cannot hit the 419
# "Page Expired" wall (the forced-true regression from #1003). Force `true`
# only when Secure is needed despite an unpinned proxy chain. Pinned behavior:
# config/session.php + tests/Feature/SessionCookieSecureTest.php.
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local


