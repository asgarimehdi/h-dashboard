# Copy this file to .env and fill in values
# Then run: php artisan key:generate

APP_NAME="Health Dashboard"
APP_ENV=local
APP_KEY=base64:JGJZnsuUSWX4haXh2zaexu4nrUfbbO9jfMDaNUgAwM8=
APP_DEBUG=true
APP_URL=http://h-dashboard.test

LOG_CHANNEL=stack
