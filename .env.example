# Copy this file to .env and fill in values
# Then run: php artisan key:generate

APP_NAME="Health Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://h-dashboard.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=h_dashboard
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120



# Zabbix API (IT Monitoring)
ZABBIX_URL=https://zabbix.example.com/api_jsonrpc.php
ZABBIX_TOKEN=your_zabbix_api_token_here

# Map tile server
# ── Map / routing / geocoding servers ──
# تایل/نقشه (سرور on-prem روی پورت 8080)
TILE_SERVER_IP=10.100.252.137
TILE_SERVER_PORT=8080
TILE_SERVER_SCHEME=http
# قالب کامل آدرس تایل روی سرور on-prem
TILE_URL_TEMPLATE=http://10.100.252.137:8080/tile/{z}/{x}/{y}.png
# مسیریابی (OSRM)
ROUTING_SERVER_IP=10.100.252.137
ROUTING_SERVER_PORT=5000
ROUTING_SERVER_SCHEME=http
# آدرس‌یابی (Nominatim)
GEOCODING_SERVER_IP=10.100.252.137
GEOCODING_SERVER_PORT=8088
GEOCODING_SERVER_SCHEME=http

# Sanctum (mobile app)
SANCTUM_STATEFUL_DOMAINS=h-dashboard.test

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123
