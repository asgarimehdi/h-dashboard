# Copy this file to .env and fill in values
# Then run: php artisan key:generate

APP_NAME="Health Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=h_dashboard
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax



# Zabbix API (IT Monitoring)
ZABBIX_URL=https://zabbix.example.com/api_jsonrpc.php
ZABBIX_TOKEN=your_zabbix_api_token_here

# Map tile server
# ── Map / routing / geocoding servers ──
# تایل/نقشه (OpenStreetMap)
TILE_SERVER_IP=tile.openstreetmap.org
TILE_SERVER_PORT=
TILE_SERVER_SCHEME=https
# قالب کامل آدرس تایل (OSM)
TILE_URL_TEMPLATE=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# مسیریابی (OSRM)
ROUTING_SERVER_IP=127.0.0.1
ROUTING_SERVER_PORT=5000
ROUTING_SERVER_SCHEME=http
# آدرس‌یابی (Nominatim)
GEOCODING_SERVER_IP=127.0.0.1
GEOCODING_SERVER_PORT=8088
GEOCODING_SERVER_SCHEME=http

# Sanctum (mobile app)
SANCTUM_STATEFUL_DOMAINS=h-dashboard.test

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123

# Sentry Error Tracking (production only)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1
