#!/usr/bin/env bash
# Light layer. Runs on every commit, so it stays in the seconds: Pint on the
# staged PHP files, nothing else. PHPStan belongs to pre-push and the suite to
# an explicit `composer verify` — a commit hook that costs a minute is a hook
# the team starts bypassing with --no-verify, which is worse than no hook.
set -euo pipefail

STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)

if [ -z "$STAGED_PHP_FILES" ]; then
    exit 0
fi

echo "Pint on staged PHP files..."

# Only files that already exist: a staged addition that was since removed
# would make pint fail on a path that is not there.
EXISTING=""
for file in $STAGED_PHP_FILES; do
    [ -f "$file" ] && EXISTING="$EXISTING $file"
done

if [ -z "$EXISTING" ]; then
    exit 0
fi

# shellcheck disable=SC2086
vendor/bin/pint $EXISTING

# Re-stage, so what is committed is what pint produced.
# shellcheck disable=SC2086
git add $EXISTING

echo "✅ Code style checked."
