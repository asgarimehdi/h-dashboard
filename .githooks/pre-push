#!/usr/bin/env bash
# Middle layer. PHPStan over the WHOLE project, not the staged subset:
# a staged-only analysis is a second analysis route that CI never runs, so any
# error that only surfaces through a dependency would never be seen locally.
#
# The full test suite is deliberately NOT run here — it takes minutes, and a
# push gate that slow is a push people cancel. Tests are opt-in:
#   VERIFY_TESTS="tests/Feature/TodoLivewireTest.php" git push
set -euo pipefail

STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)

if [ -z "$STAGED_PHP_FILES" ]; then
    echo "No PHP changes staged — skipping PHPStan."
    exit 0
fi

echo "PHPStan (full analysis)..."

# Xdebug in develop mode turns PHPStan's own diagnostics into fatals.
export XDEBUG_MODE=off

vendor/bin/phpstan analyse --no-progress

# Opt-in tests: named by the developer, never guessed. A heuristic that maps
# app/ files to tests/ does not exist here — Livewire components have no PHP
# file of their own — so a green run could mean the failing test never ran.
if [ -n "${VERIFY_TESTS:-}" ]; then
    echo ""
    echo "Running the tests you named: $VERIFY_TESTS"
    composer test -- $VERIFY_TESTS
fi

echo "✅ PHPStan clean."
