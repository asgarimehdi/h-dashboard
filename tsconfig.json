{
    // TypeScript surface for the Playwright e2e specs — issue #1069.
    // Playwright only transpiles the specs, it never type-checks them, so a
    // type error used to surface at runtime (and, with `retries: 2` in CI,
    // could hide as a flake). `npm run typecheck` runs tsc over exactly this
    // surface: nothing else in the repo is TypeScript.
    //
    // Deliberately non-strict-adjacent and scoped: the point is rot
    // prevention, not a rewrite. If the surface ever needs a ceiling, add a
    // documented ratchet here — never `@ts-nocheck` in the specs.
    "compilerOptions": {
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "es2022",
        "lib": ["es2022", "dom"],
        "types": ["node"],
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["tests/e2e/**/*", "playwright.config.ts"]
}
