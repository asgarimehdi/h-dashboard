{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "laravel-boost": {
      "type": "stdio",
      "command": "php",
      "args": [
        "artisan",
        "boost:mcp"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-lc",
        "exec docker run -i --rm --network host -e GITHUB_PERSONAL_ACCESS_TOKEN=\"$(gh auth token)\" ghcr.io/github/github-mcp-server"
      ]
    }
  }
}
